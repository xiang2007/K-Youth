# Environment Variables
# Copy this file to .env and fill in your values.
# Do NOT commit the .env file — it may contain secrets.

# Frontend → Backend URL (used when running frontend locally)
BACKEND_URL=http://localhost:8000

# Backend → Ollama URL (used when running backend locally)
OLLAMA_HOST=http://localhost:11434

# AI model to use (ollama model name)
OLLAMA_MODEL=llama3.2:latest

# Path to the jobs SQLite database (inside the backend container)
JOBS_DB_PATH=/app/src/week_2/data/jobs_d3_eval.db

# Google Gemini API key (optional — leave blank to use Ollama only)
# GOOGLE_API_KEY=